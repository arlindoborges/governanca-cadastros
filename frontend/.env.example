# Caminho relativo: funciona no browser com só a porta 3000 encaminhada (proxy no next.config).
NEXT_PUBLIC_API_URL=/api/v1

# Server Components no Next (opcional; padrão: http://127.0.0.1:3000/api/v1)
# API_URL=http://127.0.0.1:3000/api/v1

# Destino do proxy (só no servidor Next; padrão http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000
