# Copie este arquivo para .env na raiz. Nunca versionar o .env.
APP_ENV=local

# PostgreSQL local (serviço db do Compose)
POSTGRES_USER=governanca
POSTGRES_PASSWORD=governanca_local_dev
POSTGRES_DB=governanca_cadastros
# DP-010 usa 5432. Se a porta já estiver ocupada no host, altere aqui e em DATABASE_URL.
POSTGRES_PORT=5432

# Conexão do backend no host. SQLAlchemy 2 + Psycopg 3.
DATABASE_URL=postgresql+psycopg://governanca:governanca_local_dev@localhost:5432/governanca_cadastros

# Origens permitidas no CORS local (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# Portas publicadas dos containers de aplicação.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Limites de importação (opcional; padrão no backend: 10 MB, 300.000 linhas, 80 colunas).
# IMPORT_MAX_BYTES=10485760
# IMPORT_MAX_ROWS=300000
# IMPORT_MAX_COLUMNS=80
